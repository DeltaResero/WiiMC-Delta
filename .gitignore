#
# NOTE! Please use 'git ls-files -i --exclude-standard -c'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#

# ===================================================================
# Build output directories
# ===================================================================
# The CMake build folder: objects, embedded files' headers, the external
# library builds, wiimc.elf, and wiimc.dol
/build/

# ===================================================================
# Compiled files and build artifacts
# ===================================================================
# MPlayer builds in place, next to its sources
*.o
*.d
*.a
*.elf
*.dol

# ===================================================================
# IDE / Editor configuration
# ===================================================================
# Clangd / Language Server Protocol caching
.cache/
compile_commands.json
# Eclipse (C/C++ Development Tooling - CDT)
.project
.cproject
.settings/
.metadata/
# Visual Studio Code
.vscode/
# JetBrains IDEs (CLion, etc.)
.idea/
# Visual Studio
.vs/
# KDevelop
*.kdev4

# ===================================================================
# OS-specific files
# ===================================================================
# macOS custom folder attributes
.DS_Store
# Windows thumbnail cache
Thumbs.db
# KDE Dolphin folder settings
.directory

# ===================================================================
# Miscellaneous temporary files
# ===================================================================
# Editor backups and swap files
*~
\#*#
*.swp
*.swo
*.kate-swp
# Leftovers from applying patches
*.orig
*.rej
# Diffs and patches left in the root for testing
/*.diff
/*.patch
