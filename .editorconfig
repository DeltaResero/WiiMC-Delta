###############################################################################
# EDITORCONFIG
#
# This file helps maintain consistent coding styles across various editors
# and IDEs. It automatically configures settings like indentation style
# and line endings for new edits.
#
# Learn more at: http://editorconfig.org
###############################################################################

# This is the root of the project, so stop searching for .editorconfig files.
root = true


# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
# These settings apply to all files in the project.
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

# =============================================================================
# VENDORED SOURCES
# =============================================================================
# A few files in MPlayer and the vendored libraries are Latin-1 or another
# old encoding, so leave each file's encoding as it is.
[{source/mplayer/**,external/**,libs/**}]
charset = unset

# =============================================================================
# BUILD SYSTEM
# =============================================================================
# Makefiles, vendored ones too, REQUIRE tabs for indentation.
[{Makefile*,*.mak,*.mk}]
indent_style = tab


# EOF
