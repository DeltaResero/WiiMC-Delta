###############################################################################
# GIT ATTRIBUTES
#
# This file controls how git treats files. It is primarily used here to
# enforce Unix-style (LF) line endings across the project, regardless of
# the developer's operating system.
###############################################################################


# =============================================================================
# DEFAULT BEHAVIOR
# =============================================================================
# Auto-detect text files and normalize to LF.
*                           text=auto eol=lf

# =============================================================================
# SOURCE CODE
# =============================================================================
# C and C++ source files.
*.c                         text eol=lf
*.cpp                       text eol=lf

# C and C++ header files.
*.h                         text eol=lf
*.hpp                       text eol=lf

# Assembly.
*.S                         text eol=lf
*.asm                       text eol=lf

# =============================================================================
# SCRIPTS & EXECUTABLES
# =============================================================================
# Standard script extensions.
*.sh                        text eol=lf
*.pl                        text eol=lf
*.py                        text eol=lf

# Configure scripts break on CR, whatever the platform.
configure                   text eol=lf

# =============================================================================
# BUILD SYSTEM & CONFIGURATION
# =============================================================================
# Make configuration.
Makefile                    text eol=lf
*.mak                       text eol=lf
*.mk                        text eol=lf

# Linker version scripts and templates.
*.v                         text eol=lf
*.in                        text eol=lf

# =============================================================================
# DOCUMENTATION
# =============================================================================
# Markdown and plain text.
*.md                        text eol=lf
*.txt                       text eol=lf

# Standard project documentation files.
AUTHORS                     text eol=lf
LICENSE                     text eol=lf
COPYING                     text eol=lf
README                      text eol=lf
README*                     text eol=lf

# =============================================================================
# ASSETS & DATA
# =============================================================================
# Translations, embedded in the DOL and read at run time.
*.lang                      text eol=lf

# Homebrew Channel metadata and the online media list.
*.xml                       text eol=lf

# =============================================================================
# BINARY FILES
# =============================================================================
# Images and Icons.
*.png                       binary
*.jpg                       binary
*.jpeg                      binary
*.gif                       binary
*.tga                       binary
*.pnm                       binary
*.ico                       binary

# Fonts.
*.ttf                       binary
*.otf                       binary

# Archives and Compressed files.
*.gz                        binary
*.zip                       binary
*.tar                       binary

# Wii binaries.
*.dol                       binary
*.elf                       binary


# EOF
